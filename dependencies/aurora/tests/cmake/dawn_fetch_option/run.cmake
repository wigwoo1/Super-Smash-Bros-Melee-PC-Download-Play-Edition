cmake_minimum_required(VERSION 3.25)
if (NOT DEFINED TEST_ROOT OR NOT DEFINED TEST_GENERATOR)
  message(FATAL_ERROR "TEST_ROOT and TEST_GENERATOR are required")
endif ()
get_filename_component(TEST_ROOT "${TEST_ROOT}" ABSOLUTE)
if (TEST_ROOT STREQUAL CMAKE_CURRENT_LIST_DIR)
  message(FATAL_ERROR "Use a separate build directory")
endif ()
set(_generator -G "${TEST_GENERATOR}")
if (DEFINED TEST_MAKE_PROGRAM AND NOT TEST_MAKE_PROGRAM STREQUAL "")
  list(APPEND _generator "-DCMAKE_MAKE_PROGRAM=${TEST_MAKE_PROGRAM}")
endif ()
function(check name expected)
  execute_process(COMMAND "${CMAKE_COMMAND}" -S "${CMAKE_CURRENT_LIST_DIR}"
    -B "${TEST_ROOT}/${name}" ${_generator} "-DEXPECT_FETCH=${expected}" ${ARGN}
    RESULT_VARIABLE _result OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr)
  file(MAKE_DIRECTORY "${TEST_ROOT}")
  file(WRITE "${TEST_ROOT}/${name}-${expected}.log" "${_stdout}\n${_stderr}")
  if (NOT _result EQUAL 0)
    message(FATAL_ERROR "${name}/${expected} failed (${_result}):\n${_stdout}\n${_stderr}")
  endif ()
  message(STATUS "PASS ${name}: Dawn fetch ${expected}")
endfunction()
check(default ON -U DAWN_FETCH_DEPENDENCIES)
check(explicit-off OFF -DDAWN_FETCH_DEPENDENCIES:BOOL=OFF)
check(explicit-on ON -DDAWN_FETCH_DEPENDENCIES:BOOL=ON)
check(switch OFF -DDAWN_FETCH_DEPENDENCIES:BOOL=OFF)
check(switch ON -DDAWN_FETCH_DEPENDENCIES:BOOL=ON)
check(switch OFF -DDAWN_FETCH_DEPENDENCIES:BOOL=OFF)
check(legacy-internal-off OFF -DSEED_LEGACY_OFF=ON)
