include_guard(GLOBAL)
function(FetchContent_Declare name)
  if (NOT name STREQUAL "dawn")
    message(FATAL_ERROR "Unexpected dependency: ${name}")
  endif ()
endfunction()
function(FetchContent_MakeAvailable name)
  if (NOT name STREQUAL "dawn")
    message(FATAL_ERROR "Unexpected dependency: ${name}")
  endif ()
  file(WRITE "${CMAKE_BINARY_DIR}/observed-fetch.txt" "${DAWN_FETCH_DEPENDENCIES}\n")
  if (NOT "${DAWN_FETCH_DEPENDENCIES}" STREQUAL "${EXPECT_FETCH}")
    message(FATAL_ERROR
      "Dawn fetch mismatch: expected ${EXPECT_FETCH}, observed ${DAWN_FETCH_DEPENDENCIES}")
  endif ()
  add_library(webgpu_dawn INTERFACE IMPORTED GLOBAL)
  add_library(dawn::webgpu_dawn ALIAS webgpu_dawn)
  add_library(dawn::dawncpp_headers ALIAS webgpu_dawn)
endfunction()
