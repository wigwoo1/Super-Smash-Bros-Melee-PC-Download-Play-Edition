# Preserve the exact typed-null fix used by the verified Win32 runtime.
if (NOT DEFINED DAWN_SOURCE_DIR)
  message(FATAL_ERROR "DAWN_SOURCE_DIR is required")
endif ()
set(_source "${DAWN_SOURCE_DIR}/src/dawn/native/vulkan/ResourceMemoryAllocatorVk.cpp")
file(SHA256 "${_source}" _sha)
if (_sha STREQUAL "38e761c38bdad9485715b72df914cd696e60825ae50bafb951f5622e11b46511")
  message(STATUS "Dawn Win32 Vulkan handle patch already applied")
  return()
endif ()
if (NOT _sha STREQUAL "bf04aa63f762b3af961cdbaa2003b17a98db7e6c7b3fb5fb3c5525eb6a1b804d")
  message(FATAL_ERROR "Dawn Vulkan allocator differs from the pinned source; refusing to overwrite local changes")
endif ()
file(READ "${_source}" _text)
string(REPLACE "dedicatedInfo.buffer = VK_NULL_HANDLE;" "dedicatedInfo.buffer = VkBuffer{};" _text "${_text}")
file(CONFIGURE OUTPUT "${_source}" CONTENT "${_text}" @ONLY NEWLINE_STYLE UNIX)
file(SHA256 "${_source}" _sha)
if (NOT _sha STREQUAL "38e761c38bdad9485715b72df914cd696e60825ae50bafb951f5622e11b46511")
  message(FATAL_ERROR "Dawn Win32 Vulkan handle patch verification failed")
endif ()
